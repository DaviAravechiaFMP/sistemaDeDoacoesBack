# Variáveis de ambiente — NÃO versione este arquivo (já está no .gitignore)

# URL de conexão PostgreSQL para ambientes remotos/nuvem (ex: Render, Supabase, Neon)
# Se definida, a aplicação usará DATABASE_URL com SSL
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Configurações locais do PostgreSQL (fallback caso DATABASE_URL não seja definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=sistema_doacoes

# Servidor
PORT=3000

# JWT — troque por uma string longa e aleatória antes de ir para produção
JWT_SECRET=chave_super_secreta_fmp_2026
JWT_EXPIRES_IN=8h
